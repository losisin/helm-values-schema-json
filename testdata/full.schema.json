{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schema",
    "title": "Helm Values Schema",
    "description": "Schema for Helm values",
    "$ref": "schema/product.json",
    "type": "object",
    "required": [
        "nameOverride"
    ],
    "properties": {
        "affinity": {
            "type": "object",
            "properties": {
                "nodeAffinity": {
                    "type": "object",
                    "maxProperties": 2,
                    "minProperties": 1,
                    "properties": {
                        "preferredDuringSchedulingIgnoredDuringExecution": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "preference": {
                                        "$id": "https://example.com/schema.json",
                                        "type": "object",
                                        "properties": {
                                            "matchExpressions": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "key": {
                                                            "type": "string"
                                                        },
                                                        "operator": {
                                                            "type": "string"
                                                        },
                                                        "values": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        },
                                        "patternProperties": {
                                            "^[a-z]$": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "weight": {
                                        "type": "integer"
                                    }
                                }
                            }
                        },
                        "requiredDuringSchedulingIgnoredDuringExecution": {
                            "type": "object",
                            "properties": {
                                "nodeSelectorTerms": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "matchExpressions": {
                                                "type": "array",
                                                "items": {
                                                    "type": "object",
                                                    "properties": {
                                                        "key": {
                                                            "examples": [
                                                                "topology.kubernetes.io/zone",
                                                                "kubernetes.io/hostname"
                                                            ],
                                                            "type": "string"
                                                        },
                                                        "operator": {
                                                            "type": "string"
                                                        },
                                                        "values": {
                                                            "type": "array",
                                                            "items": {
                                                                "type": "string"
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "additionalProperties": false
                }
            }
        },
        "annotations": {
            "const": {
                "foo": "bar"
            }
        },
        "empty": {
            "type": [
                "string",
                "null"
            ]
        },
        "fullnameOverride": {
            "title": "My title",
            "description": "My description",
            "type": "string",
            "pattern": "^[a-z]$"
        },
        "image": {
            "type": "object",
            "required": [
                "repository"
            ],
            "properties": {
                "pullPolicy": {
                    "deprecated": true,
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "readOnly": true,
                    "type": "string"
                }
            }
        },
        "imagePullSecrets": {
            "type": [
                "array",
                "null"
            ],
            "items": {
                "type": "object",
                "properties": {
                    "key": {
                        "type": "string"
                    }
                }
            }
        },
        "labels": {
            "type": "object"
        },
        "nameOverride": {
            "type": "string"
        },
        "ports": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "enabled": {
                        "type": "boolean"
                    },
                    "port": {
                        "type": "integer"
                    },
                    "protocol": {
                        "type": "string",
                        "enum": [
                            "tcp",
                            "udp"
                        ]
                    }
                }
            }
        },
        "replicas": {
            "type": "integer",
            "maximum": 10,
            "minimum": 1,
            "multipleOf": 2
        },
        "service": {
            "type": "string",
            "enum": [
                "ClusterIP",
                "LoadBalancer",
                null
            ]
        },
        "shorthand": {
            "type": "object",
            "properties": {
                "args": {
                    "default": [
                        "--verbose"
                    ],
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "nodeSelector": {
                    "default": {},
                    "type": "object"
                },
                "podLabels": {
                    "default": {},
                    "type": "object"
                },
                "replicaCount": {
                    "default": 3,
                    "type": "integer"
                },
                "resources": {
                    "default": {
                        "limits": {
                            "cpu": "100m"
                        }
                    },
                    "type": "object",
                    "properties": {
                        "limits": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                },
                "strategy": {
                    "default": "RollingUpdate",
                    "const": "RollingUpdate"
                }
            }
        },
        "subchart": {
            "$ref": "https://example.com/schema.json",
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "name": {
                    "type": "string"
                },
                "values": {
                    "type": "object",
                    "properties": {
                        "bar": {
                            "type": "string"
                        },
                        "foo": {
                            "type": "string"
                        }
                    }
                }
            },
            "unevaluatedProperties": false
        },
        "tolerations": {
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "object",
                "properties": {
                    "effect": {
                        "type": "string"
                    },
                    "key": {
                        "type": "string"
                    },
                    "operator": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        }
    },
    "additionalProperties": true
}
